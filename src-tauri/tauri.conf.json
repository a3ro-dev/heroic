{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Heroic",
  "version": "0.1.0",
  "identifier": "dev.akshat.heroic",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Heroic",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#0d0d0e",
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --use-fake-ui-for-media-stream --force_high_performance_gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Wear a superhero on camera",
    "longDescription": "Heroic tracks your body, hands and face on the GPU and fits a rigged 3D hero over you in real time, then sends the result to your video calls as a camera.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
